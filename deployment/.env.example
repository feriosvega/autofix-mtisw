# Usuario de Docker Hub donde el pipeline publica las imágenes
DOCKERHUB_USER=tu_usuario_dockerhub
# IP pública (o dominio) del servidor cloud, sin http:// (ej. 54.210.12.34).
# Si PUBLIC_PORT no es 80, incluir el puerto: localhost:8088
PUBLIC_HOST=localhost
PUBLIC_PORT=80
# Contraseñas (cambiarlas en el servidor)
DB_ROOT_PASSWORD=root2026
DB_PASSWORD=autofix2026
KEYCLOAK_DB_PASSWORD=keycloak2026
KEYCLOAK_ADMIN_PASSWORD=admin2026
